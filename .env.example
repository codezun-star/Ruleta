# ─── Sitio ────────────────────────────────────────────────────────────────
# URL pública. En local déjala en http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://ruleta.codezun.com

# ─── Correo (Resend) ──────────────────────────────────────────────────────
# Se usa a partir de la Fase 5. El dominio debe estar verificado en Resend
# con SPF, DKIM y DMARC; los pasos están en docs/resend-dns.md.
RESEND_API_KEY=
EMAIL_FROM="Tómbola <hola@ruleta.codezun.com>"
EMAIL_REPLY_TO=hola@ruleta.codezun.com

# ─── Base de datos ────────────────────────────────────────────────────────
# Fase 5. Postgres de Supabase o de Vercel.
DATABASE_URL=

# Clave AES-GCM de 32 bytes en base64 para cifrar las asignaciones del amigo
# secreto. Genérala con:  openssl rand -base64 32
ASSIGNMENTS_ENCRYPTION_KEY=

# ─── Límite de uso y captcha ──────────────────────────────────────────────
# Fase 6.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protege la ruta de limpieza automática (/api/cron/purge).
CRON_SECRET=
